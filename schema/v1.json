{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sajad2025/beelzebub/schema/v1.json",
  "title": "Beelzebub's Tales chapter (v1)",
  "description": "One JSON document per chapter of Gurdjieff's Beelzebub's Tales to His Grandson. Frozen schema -- breaking changes require v2.",
  "type": "object",
  "required": [
    "id",
    "canonical_id",
    "urn",
    "title",
    "title_raw",
    "title_slug",
    "number",
    "page_start",
    "page_end",
    "paragraphs",
    "source",
    "source_sha256"
  ],
  "properties": {
    "id":           { "type": "integer", "minimum": 0, "maximum": 48 },
    "canonical_id": { "type": "string", "pattern": "^beelzebub/(ch[0-9]{2}|front-matter)$" },
    "urn":          { "type": "string", "pattern": "^urn:beelzebub:" },
    "title":        { "type": "string", "minLength": 1 },
    "title_raw":    { "type": "string", "minLength": 1 },
    "title_slug":   { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "number":       { "type": "integer", "minimum": 0, "maximum": 48 },
    "page_start":   { "type": "integer", "minimum": 0 },
    "page_end":     { "type": "integer", "minimum": 0 },
    "kind":         { "type": "string", "enum": ["chapter", "front_matter"] },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["anchor", "chapter", "page_start", "page_end", "text"],
        "properties": {
          "anchor":     { "type": "string", "pattern": "^([0-9]+\\.[0-9]+(-[0-9]+)?|fa\\.[0-9]+)$" },
          "chapter":    { "type": "integer", "minimum": 0, "maximum": 48 },
          "page_start": { "type": "integer", "minimum": 0 },
          "page_end":   { "type": "integer", "minimum": 0 },
          "text":       { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "source":        { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
